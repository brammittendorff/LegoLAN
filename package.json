{
  "name": "legolan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run build && wrangler pages dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node tests/integration.mjs",
    "test:ui": "node tests/ui-zaal.mjs",
    "test:e2e": "node tests/e2e-mollie.mjs",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply legolan --local",
    "db:migrate:remote": "wrangler d1 migrations apply legolan --remote",
    "deploy": "npm run build && wrangler pages deploy --branch main"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "paseto-ts": "^2.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.114.0"
  }
}
